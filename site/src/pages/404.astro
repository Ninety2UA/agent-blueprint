---
// 404: an address with no page. It offers the home page and the skills catalog. It has no
// canonical URL of its own and stays out of the search index (no data-pagefind-body).
import TitleBlock from '../components/TitleBlock.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found · Agent Blueprint" description="There is no page at this address on the Agent Blueprint site." canonical={false} sheet="Not found">
  <section class="nf" aria-labelledby="nf-h">
    <div class="wrap nf-in">
      <div class="nf-l">
        <h1 id="nf-h" class="h-display">Nothing is drawn here.</h1>
        <p class="lede">This address is not a page on the site. The link may have a typo, or the page may have moved.</p>
        <div class="nf-go">
          <a class="btn btn-primary" href="/">Go to the home page</a>
          <a class="btn btn-ghost" href="/skills/">Browse the skills</a>
        </div>
      </div>
      <TitleBlock class="nf-tb" cols="minmax(0, 1fr) minmax(0, 1fr)" cells={[{ label: 'Sheet', value: '404' }, { label: 'Status', value: 'Not found' }]} />
    </div>
  </section>
</BaseLayout>

<style>
  .nf { border-bottom: 1px solid var(--hair); }
  .nf-in { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-7); align-items: end; padding-block: clamp(64px, 8vw, 128px); }
  .nf-l .lede { margin-top: var(--s-4); }
  .nf-go { display: flex; flex-wrap: wrap; gap: 12px; margin-top: var(--s-6); }
  .nf-in > :global(.nf-tb) { max-width: 360px; justify-self: end; width: 100%; }
  .nf-in :global(.nf-tb dd) { font-family: var(--font-mono); }
  @media (max-width: 860px) {
    .nf-in { grid-template-columns: minmax(0, 1fr); }
    .nf-in > :global(.nf-tb) { justify-self: start; }
  }
</style>
