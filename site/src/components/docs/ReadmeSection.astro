---
// A docs page's README section: renders the section's <Content /> (the default slot) and, with
// `drop`, replaces the listed tables with their pointers (section.mjs). Everything else is the
// README's own text, so a README edit changes the page on the next build (R13).
import { dropTables } from './section.mjs';

interface Props {
  drop?: { header: string[]; pointer: string }[];
}
const { drop } = Astro.props;
const html = await Astro.slots.render('default');
---
<div class="readme-section"><Fragment set:html={drop?.length ? dropTables(html, drop) : html} /></div>
