---
// A page's two Markdown controls, in its header: "Copy for your agent" copies the page's Markdown and
// "View as Markdown" links to the same text at the page's address plus .md. The copy text sits in the
// button's data-copy attribute, so a copy needs no request. Measured on the built pages, it adds at most
// 1.8 KB of Brotli to a page of 25 KB and about 0.4 KB to most, because the page already holds the words.
import { markdownHref, pageMarkdown } from '../../lib/page-markdown.mjs';
import CopyButton from '../CopyButton.astro';

interface Props {
  kind: 'docs' | 'guides' | 'tutorials';
  slug: string;
  /** the page's address */
  href: string;
}
const { kind, slug, href } = Astro.props;
---
<div class="dp-md" data-pagefind-ignore>
  <CopyButton
    label="Copy for your agent: this page as Markdown"
    display="Copy for your agent"
    hint="Open View as Markdown and copy from there."
    text={pageMarkdown(kind, slug)}
  />
  <a class="dp-md-view" href={markdownHref(href)}>View as Markdown</a>
</div>
