---
// The GitHub documents a docs page points to, listed under its intro (the intro's last sentence
// introduces them): with `hostDocs`, each tool's support note at that heading anchor, tools and
// files from getSiteData(); with `repoDoc`, one repository file.
import { IC } from '../icons';
import { docRefs } from '../../lib/page-markdown.mjs';
import { getSiteData } from '../../lib/site.mjs';

interface Props {
  /** heading anchor inside each docs/hosts/<tool>.md, e.g. "smoke-status" */
  hostDocs?: string;
  /** repository path, e.g. "docs/upgrade/v4.md" */
  repoDoc?: string;
}
const { hostDocs, repoDoc } = Astro.props;
const links = docRefs({ hostDocs, repoDoc }, getSiteData());
---
{links.length > 0 && (
  <ul class:list={['doc-refs', { 'doc-refs-one': links.length === 1 }]}>
    {links.map((l) => (
      <li><a href={l.href}>{l.code ? <code>{l.label}</code> : l.label}<Fragment set:html={IC.arrow} /></a></li>
    ))}
  </ul>
)}
