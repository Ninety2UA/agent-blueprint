---
// Fig. 1: the README's development loop as a looping animation (motion/loop-workflow) drawn on the
// sheet itself, the way the film is: a tracer runs the six steps and docs/ carries the loop back to
// Orient. Under it, the legend gives every step's text from the README, with skill names linked.
// The video plays on its own while on screen (video-figures.ts); its frame size comes from the file.
import '../../styles/media.css';
import DrawingSheet from '../DrawingSheet.astro';
import { IC } from '../icons';
import { loop as loopVideo } from '../loops';
import { mp4Facts } from '../media';
import TitleBlock from '../TitleBlock.astro';
import { Num, wf } from './data';

const { loop, pipelines, gates, counts } = wf;
const video = loopVideo('loop-workflow');
const { width, height } = mp4Facts('media/loop-workflow.mp4');
---
<section class="wf-sec" id="loop" aria-labelledby="loop-h">
  <div class="wrap">
    <div class="wf-sec-head">
      <p class="sec-ref"><span class="bub" aria-hidden="true">1</span>Fig. 1</p>
      <h2 id="loop-h" class="h-sec">Every feature takes the same loop.</h2>
      <p class="body">{Num(loop.length)} steps, from getting oriented to merging the branch, each with its own skills. The loop closes through <code>docs/</code>: what one feature records there, the next session reads first.</p>
    </div>
    <figure class="wf-fig loop-fig" data-vfig aria-labelledby="loop-h">
      <DrawingSheet class="loop-sheet">
        <div class="vf-media" style={`aspect-ratio:${width} / ${height}`}>
          <img class="vf-poster" src={video.src.replace(/\.mp4$/, '.jpg')} width={width} height={height} alt="" loading="lazy" decoding="async" />
          <video muted playsinline loop preload="none" controls width={width} height={height} aria-label={video.alt}>
            <source src={video.src} type="video/mp4" />
          </video>
          <button class="vf-big" type="button" aria-label={`Play ${video.label}`}><Fragment set:html={IC.play} /><span>Play</span></button>
        </div>
        <ol class="loop-legend">
          {loop.map((step) => (
            <li class:list={['loop-item', { 'is-opt': step.optional }]}>
              <h3 class="loop-name"><span class="loop-n" aria-hidden="true">{step.n}</span>{step.name}{step.optional && <span class="loop-opt"><span class="sr-only">, </span>optional</span>}</h3>
              <p class="loop-text" set:html={step.html} />
            </li>
          ))}
        </ol>
      </DrawingSheet>
      <TitleBlock
        attached
        label="About this drawing"
        cells={[
          { label: 'Drawing', value: 'The development loop' },
          { label: 'Steps', value: String(loop.length) },
          { label: 'Pipelines', value: String(pipelines.length) },
          { label: 'Quality gates', value: String(gates.length) },
          { label: 'Skills', value: String(counts.skills), claim: 'skills' },
          { label: 'Source', value: 'README.md', code: true },
        ]}
      />
    </figure>
  </div>
</section>
