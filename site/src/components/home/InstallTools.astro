---
// Install for the tools you use: one tab per row of the README install table, built with
// the shared Tabs. Each panel shows the tool's route as the Getting started tabs do (each
// command a copy control, the README's words between them), how to name a skill in that
// tool, and its hooks and helpers from the support table.
import Cmd from '../Cmd.astro';
import Tabs from '../Tabs.astro';
import { routeSteps } from '../docs/route.mjs';
import type { Tool } from '../../lib/site.mjs';
import { md, site } from './home-data';

const { tools } = site;

function panel(tool: Tool) {
  const hooks = /^none\b/i.test(tool.support.hooks) ? 'None. Every pipeline runs without them.' : md(tool.support.hooks);
  return { steps: routeSteps(tool.route, tool.commands), hooks, helpers: md(tool.support.helpers) };
}
const panels = tools.map((t) => ({ tool: t, ...panel(t) }));
---
<section class="sec tools" id="tools" aria-labelledby="tools-h">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="tools-h" class="h-sec">Install for the tools you use.</h2>
      <p class="body">Each tool installs Agent Blueprint from GitHub by its own route. Pick yours here; to set up every tool on your <code>PATH</code> at once, clone the repository and run <code>install.sh</code>.</p>
    </div>
    <Tabs id="install" label="Tools" items={tools.map((t) => ({ id: t.id, label: t.name }))}>
      {panels.map((p) => (
        <Fragment slot={p.tool.id}>
          <dl class="spec">
            <dt>Install</dt>
            <dd class="steps">
              {p.steps.map((step) =>
                step.kind === 'cmd'
                  ? <Cmd lines={[step.text]} prompt label={`Install command for ${p.tool.name}`} copyLabel={`Copy ${step.text}`} />
                  : <p class="hint" set:html={step.html} />,
              )}
            </dd>
            <dt>Name a skill</dt>
            <dd>
              {p.tool.naming.syntax ? (
                <Fragment>
                  <p class="say">{p.tool.naming.example}</p>
                  <p class="hint">Or describe the task: every tool also picks a skill on its own when your request matches its description.</p>
                </Fragment>
              ) : (
                <Fragment>
                  <p class="say-plain">Ask in plain words: "{p.tool.naming.example}".</p>
                  <p class="hint">{p.tool.name} has no command for invoking a skill, so name it in the request.</p>
                </Fragment>
              )}
            </dd>
            <dt>Support</dt>
            <dd>
              <div class="facts">
                <p><b>Hooks</b><Fragment set:html={p.hooks} /></p>
                <p><b>Helpers</b><Fragment set:html={p.helpers} /></p>
              </div>
            </dd>
          </dl>
        </Fragment>
      ))}
    </Tabs>
  </div>
</section>
<style>
  /* one command block or line of words per route step, evenly spaced */
  .steps { display: grid; gap: 8px; }
  .steps .hint { margin-top: 0; }
</style>
