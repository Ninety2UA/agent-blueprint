---
// A looping figure: hairline frame, registration marks outside the corners and a mono caption with
// its figure number. It plays on its own while on screen; VideoMedia holds the video box and
// video-figures.ts the rules for playing it.
import '../styles/media.css';
import RegMarks from './RegMarks.astro';
import VideoMedia from './VideoMedia.astro';

interface Props {
  /** path under public/, e.g. "/media/loop-review.mp4"; the poster is the .jpg beside it */
  src: string;
  /** figure number, in page order */
  num: number;
  /** what the video shows, with its real names and numbers: the text alternative */
  alt: string;
  /** names the video on the fallback Play button: "Play the review animation" */
  label: string;
  class?: string;
}
const { src, num, alt, label, class: cls } = Astro.props;
const capId = `cap-${src.split('/').pop()!.replace(/\.\w+$/, '')}-${num}`;
---
<figure class:list={['vfig', cls]} data-vfig>
  <VideoMedia src={src} alt={alt} label={label} describedby={capId}>
    <RegMarks />
    <slot name="over" slot="over" />
  </VideoMedia>
  <figcaption class="vf-cap">
    <span id={capId}><b>Fig. {num}</b><slot /></span>
  </figcaption>
  <slot name="after" />
</figure>
