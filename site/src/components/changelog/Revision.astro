---
// One release as a drawing's revision block (h/changelog.html): a head with the revision, date,
// description and type; the release notes split into labelled groups; links to the notes file and
// the diff on GitHub. A release with no notes file shows its README summary instead. The heading is
// the summary's headline.
import { inlineCode } from '../../lib/text.mjs';
import { headline, releaseId, releaseType, splitNotes } from './changelog.mjs';

interface Props {
  version: string;
  date: string;
  summary: string;
  /** the rendered docs/releases/v<version>-release-notes.md, when there is one */
  notesHtml?: string;
  /** the release this one follows, for the diff link */
  previous?: string;
  repoUrl: string;
}
const { version, date, summary, notesHtml, previous, repoUrl } = Astro.props;
const id = releaseId(version);
const type = releaseType(version);
const title = headline(summary);
const notes = notesHtml ? splitNotes(notesHtml) : null;
const lede = notes ? notes.lede : `<p>${inlineCode(summary)}</p>`;
const links = [
  notes && { text: 'Release notes', href: `${repoUrl}/blob/main/docs/releases/v${version}-release-notes.md` },
  previous && /^\d+\.\d+\.\d+$/.test(previous) && { text: 'Full diff on GitHub', href: `${repoUrl}/compare/v${previous}...v${version}` },
].filter((l): l is { text: string; href: string } => Boolean(l));
---
<article class:list={['rev', { 'rev-major': type === 'Major' }]} id={id} aria-labelledby={`h-${id}`} data-rev data-release={version}>
  <div class="rev-head">
    <div class="rc rc-rev"><span class="f">Rev</span><span class="v"><svg class="delta" viewBox="0 0 20 18" aria-hidden="true"><path d="M10 1.5 18.5 16.5H1.5Z" /></svg><span class="rev-n">{version}</span></span></div>
    <div class="rc rc-date"><span class="f">Date</span><time class="v" datetime={date}>{date}</time></div>
    <div class="rc rc-desc"><span class="f">Description</span><h2 class="v rev-title" id={`h-${id}`} set:html={inlineCode(title)} /></div>
    <div class="rc rc-kind"><span class="f">Type</span><span class="v">{type}</span></div>
  </div>
  {lede && <div class="rev-lede" set:html={lede} />}
  {notes && notes.groups.length > 0 && (
    <dl class="rev-groups">
      {notes.groups.map((g) => (
        <>
          <dt>{g.label}</dt>
          <dd set:html={g.html} />
        </>
      ))}
    </dl>
  )}
  {links.length > 0 && (
    <div class="rev-links">
      {links.map((l) => (
        <a class="link" href={l.href}><span class="link-rule" aria-hidden="true"></span><span>{l.text}</span></a>
      ))}
    </div>
  )}
</article>
